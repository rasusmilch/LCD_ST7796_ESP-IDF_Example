  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Coding_Projects\Diesel_Heater_Controller\Code\LCD_Example\esp-idf\app_update && D:\ESP-IDF_Tools\tools\cmake\3.30.2\bin\cmake.exe -E echo "Error: The target encrypted-otadata-flash requires" && D:\ESP-IDF_Tools\tools\cmake\3.30.2\bin\cmake.exe -E echo "CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT to be enabled." && D:\ESP-IDF_Tools\tools\cmake\3.30.2\bin\cmake.exe -E env "FAIL_MESSAGE=Failed executing target (see errors on lines above)" D:/ESP-IDF_Tools/tools/cmake/3.30.2/bin/cmake.exe -P D:/esp/v5.5.1/esp-idf/tools/cmake/scripts/fail.cmake"

