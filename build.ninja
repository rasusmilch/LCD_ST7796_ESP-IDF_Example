  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Coding_Projects\Diesel_Heater_Controller\Code\LCD_Example\esp-idf\main && D:\ESP-IDF_Tools\tools\cmake\3.30.2\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

