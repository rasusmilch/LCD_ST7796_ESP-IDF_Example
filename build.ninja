build esp-idf/main/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\Coding_Projects\Diesel_Heater_Controller\Code\LCD_Example\esp-idf\main && D:\ST\STM32CubeCLT_1.18.0\CMake\bin\cmake-gui.exe -SD:\Coding_Projects\Diesel_Heater_Controller\Code\LCD_Example -BD:\Coding_Projects\Diesel_Heater_Controller\Code\LCD_Example"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

